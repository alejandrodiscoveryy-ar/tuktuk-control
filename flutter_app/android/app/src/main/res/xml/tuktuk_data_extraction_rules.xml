<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Android 12+: evita exportar datos privados por copia en nube. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <!-- Android 12+: regula por separado la transferencia a otro móvil. -->
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
